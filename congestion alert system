# Alert limits (you can change these)
HIGH_LIMIT = 0.70
MODERATE_LIMIT = 0.40


def predict_congestion_probability(junction, date_time):
    """Returns the probability (0 to 1) that the junction will be congested at date_time."""

    if junction not in thresholds:
        raise ValueError(f"Junction {junction} was not in the training data. Use one of: {list(thresholds.keys())}")

    when = pd.to_datetime(date_time)

    # Build one row with the SAME columns as X, filled with zeros
    new_row = pd.DataFrame(0, index=[0], columns=X.columns)

    # Switch ON the columns that match this junction and time
    names_to_switch_on = [
        "Junction_" + str(junction),
        "Hour_" + str(when.hour),
        "DayOfWeek_" + str(when.dayofweek),
        "Month_" + str(when.month)
    ]
    for name in names_to_switch_on:
        if name in new_row.columns:     # default categories (Junction 1, Hour 0...) have no column
            new_row[name] = 1

    # Scale it with the same scaler, then predict the probability of class 1
    new_row_scaled = scaler.transform(new_row)
    probability = model.predict_proba(new_row_scaled)[0, 1]
    return probability


def get_alert_level(probability):
    """Converts a probability into an alert level."""
    if probability >= HIGH_LIMIT:
        return "🔴 HIGH"
    elif probability >= MODERATE_LIMIT:
        return "🟡 MODERATE"
    else:
        return "🟢 LOW"


def congestion_alert(junction, date_time):
    """Prints a complete alert message for one junction and time."""
    when = pd.to_datetime(date_time)
    probability = predict_congestion_probability(junction, date_time)
    level = get_alert_level(probability)

    print("=" * 55)
    print(f"Junction : {junction}")
    print(f"Time     : {when.strftime('%A, %d %B %Y, %H:%M')}")
    print(f"Chance of congestion : {probability * 100:.1f}%")
    print(f"ALERT LEVEL          : {level}")
    print(f"(Congestion here means more than {thresholds[junction]:.0f} vehicles in the hour)")
    print("=" * 55)


